files_with_version_number = {
  './.version' => ['{x}'],
  './package.json' => ['"version": "{x}"'],
  './plugin.xml' => ['id="cordova-plugin-purchases" version="{x}"'],
  './src/android/PurchasesPlugin.java' => ['PLUGIN_VERSION = "{x}"'],
  './src/ios/PurchasesPlugin.swift' => ['return "{x}"']
}
files_to_update_phc_version = {
  'plugin.xml' => [
    'name="PurchasesHybridCommon" spec="{x}"',
    'com.revenuecat.purchases:purchases-hybrid-common:{x}'
  ]
}
files_to_update_on_latest_stable_releases = {
  './scripts/docs/index.html' => ['cordova-plugin-purchases-docs/{x}/']
}
repo_name = 'cordova-plugin-purchases'
changelog_latest_path = './CHANGELOG.latest.md'
changelog_path = './CHANGELOG.md'
versions_path = './VERSIONS.md'

before_all do
  setup_circle_ci
end

desc "Bump version, edit changelog, and create pull request"
lane :bump do |options|
  phc_version = get_phc_version
  bump_version_update_changelog_create_pr(
    current_version: current_version_number,
    changelog_latest_path: changelog_latest_path,
    changelog_path: changelog_path,
    files_to_update: files_with_version_number,
    files_to_update_on_latest_stable_releases: files_to_update_on_latest_stable_releases,
    repo_name: repo_name,
    github_rate_limit: options[:github_rate_limit],
    editor: options[:editor],
    next_version: options[:next_version],
    automatic_release: options[:automatic_release],
    hybrid_common_version: phc_version,
    versions_file_path: versions_path,
    is_prerelease: options[:is_prerelease]
  )
  update_hybrids_versions_file(
    versions_file_path: versions_path,
    new_sdk_version: current_version_number,
    hybrid_common_version: phc_version
  )
  commit_current_changes(commit_message: 'Update VERSIONS.md')
  push_to_git_remote(set_upstream: true)
end

desc "Automatically bumps version, edit changelog, and create pull request"
lane :automatic_bump do |options|
  next_version, type_of_bump = determine_next_version_using_labels(
    repo_name: repo_name,
    github_rate_limit: options[:github_rate_limit]
  )
  options[:next_version] = next_version
  options[:automatic_release] = true
  if type_of_bump == :skip
    UI.message('Skipping automatic bump since the next version doesn\'t include public facing changes')
    next
  end
  if type_of_bump == :major
    UI.message('Skipping automatic bump since the next version is a major release')
    next
  end
  bump(options)
end

desc "Creates GitHub release and publishes package"
lane :release do |options|
  version_number = current_version_number
  is_prerelease = Gem::Version.new(version_number).prerelease?

  args = [
    'npm',
    'publish',
    is_prerelease ? '--tag next' : nil
  ].compact

  Dir.chdir(get_root_folder) do
    sh(args)
  end
  github_release(version: version_number)
end

desc "Make github release"
lane :github_release do |options|
  create_github_release(
    version: options[:version],
    repo_name: repo_name,
    github_api_token: ENV["GITHUB_TOKEN"],
    changelog_latest_path: changelog_latest_path,
    upload_assets: []
  )
end

desc "Tag current branch with current version number"
lane :tag_current_branch do |options|
  version_number = current_version_number
  check_no_git_tag_exists(version_number)

  add_git_tag(tag: version_number)
  push_git_tags(tag: version_number)
end

desc "Update hybrid common in plugin.xml and pushes changes to a new branch if open_pr option is true"
lane :update_hybrid_common do |options|
  if options[:dry_run]
    dry_run = true
  end
  if options[:version]
    new_version_number = options[:version]
  else
    UI.user_error!("Missing `version` argument")
  end

  current_phc_version = get_phc_version

  UI.message("ℹ️  Current Purchases Hybrid Common version: #{current_phc_version}")
  UI.message("ℹ️  Setting Purchases Hybrid Common version: #{new_version_number}")

  if dry_run
    UI.message('ℹ️  Nothing more to do, dry_run: true')
    next
  end

  bump_phc_version(
    repo_name: repo_name,
    files_to_update: files_to_update_phc_version,
    current_version: current_phc_version,
    next_version: new_version_number,
    open_pr: options[:open_pr] || false,
    automatic_release: options[:automatic_release] || false,
    enable_auto_merge: options[:automatic_release] || false
  )
end

desc "Run maestro E2E tests on iOS"
lane :run_maestro_e2e_tests_ios do
  UI.user_error!("RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE is not set") if ENV["RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE"].to_s.empty?
  repo_root = File.expand_path("../")
  sh("cd '#{repo_root}' && npm install && npm run build")
  Dir.chdir("../e2e-tests/MaestroTestApp") do
    sh("sed -i '' 's/MAESTRO_TESTS_REVENUECAT_API_KEY/'\"$RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE\"'/g' www/js/app.js")
    UI.user_error!("API key placeholder was not replaced in app.js") if File.read("www/js/app.js").include?("MAESTRO_TESTS_REVENUECAT_API_KEY")
    # CocoaPods is installed here (not in a separate CircleCI step) because the
    # `install-ruby` cache can restore a state where the rbenv `pod` shim exists
    # but the gem does not. Installing inside Bundler.with_unbundled_env right
    # before the pod-consuming commands sidesteps that interaction.
    Bundler.with_unbundled_env do
      sh("gem install cocoapods --no-document")
    end
    sh("cordova platform add ios")
    Bundler.with_unbundled_env do
      sh("cordova plugin add '#{repo_root}' --link --nosave --force")
    end
    Bundler.with_unbundled_env do
      sh("cd platforms/ios && pod install --repo-update")
      # `cordova prepare ios` re-invokes `pod` under the hood, so it must also
      # run with Bundler unbundled to pick up the globally-installed cocoapods.
      sh("cordova prepare ios")
    end
    sh("xcodebuild -workspace platforms/ios/App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 17' build CONFIGURATION_BUILD_DIR=#{Dir.pwd}/build/emulator")
    sh("xcrun simctl install booted build/emulator/MaestroTestApp.app")
  end
  run_maestro_e2e_tests(flow_dir: "../e2e-tests/maestro/", output_dir: "test_output")
end

desc "Build maestro E2E test app for Android"
lane :build_maestro_app_android do
  UI.user_error!("RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE is not set") if ENV["RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE"].to_s.empty?
  repo_root = File.expand_path("../")
  sh("cd '#{repo_root}' && npm install && npm run build")
  Dir.chdir("../e2e-tests/MaestroTestApp") do
    sh("sed -i 's/MAESTRO_TESTS_REVENUECAT_API_KEY/'\"$RC_E2E_TEST_API_KEY_PRODUCTION_TEST_STORE\"'/g' www/js/app.js")
    UI.user_error!("API key placeholder was not replaced in app.js") if File.read("www/js/app.js").include?("MAESTRO_TESTS_REVENUECAT_API_KEY")
    sh("cordova platform add android")
    sh("cordova plugin add '#{repo_root}' --link --nosave --force")
    sh("cordova build android")
  end
end

desc "Run maestro E2E tests on Android (emulator must be running)"
lane :run_maestro_e2e_tests_android do
  sh("adb install ../e2e-tests/MaestroTestApp/platforms/android/app/build/outputs/apk/debug/app-debug.apk")
  run_maestro_e2e_tests(flow_dir: "../e2e-tests/maestro/", output_dir: "test_output")
end

desc "Build released and local Cordova SDK update test apps"
lane :build_sdk_update_test_apps do |options|
  require 'json'
  require 'fileutils'
  require 'digest'
  platform = sdk_update_test_platform(options)
  root = get_root_folder
  output = sdk_update_test_apps_dir(platform, options)
  template = "#{root}/e2e-tests/SDKUpdateTester"
  api_key = ENV['WORKFLOWS_TEST_STORE_API_KEY']
  UI.user_error!('WORKFLOWS_TEST_STORE_API_KEY must contain a Test Store key') unless api_key&.start_with?('test_')
  release_version = options[:release_version]
  unless release_version
    published_versions = JSON.parse(sh('npm', 'view', 'cordova-plugin-purchases', 'versions', '--json', log: false))
    cutoff = Gem::Version.new(current_version_number).bump.to_s
    loop do
      release_version = get_latest_release_before_version(repo_name: 'cordova-plugin-purchases', version: cutoff)
      break if published_versions.include?(release_version)
      UI.message("Skipping SDK tag #{release_version}: its npm artifact is not published")
      cutoff = release_version
    end
  end
  FileUtils.rm_rf(output)
  FileUtils.mkdir_p(output)
  archive = nil
  Dir.chdir(root) do
    sh('npm', 'install', '--legacy-peer-deps', '--no-audit', '--no-fund')
    sh('npm', 'run', 'build')
    sh('npm', 'pack', '--pack-destination', output, log: false)
    archives = Dir.glob("#{output}/*.tgz")
    UI.user_error!('Expected one packed SDK artifact') unless archives.length == 1
    archive = archives.first
  end
  signing = "#{output}/debug.keystore"
  if platform == 'android'
    sh('keytool', '-genkeypair', '-keystore', signing, '-storepass', 'android', '-keypass', 'android',
      '-alias', 'androiddebugkey', '-keyalg', 'RSA', '-keysize', '2048', '-validity', '10000',
      '-dname', 'CN=Android Debug,O=Android,C=US', '-storetype', 'JKS')
  else
    sdk_update_test_build(['bundle', 'exec', 'pod', 'repo', 'update'], "#{output}/pods-repo.log", api_key)
  end
  %w[release local].each_with_index do |variant, index|
    dir = "#{output}/#{variant}"
    project = "#{dir}/project"
    FileUtils.mkdir_p("#{project}/www")
    %w[package.json package-lock.json config.xml tsconfig.json index.html src].each do |name|
      FileUtils.cp_r("#{template}/#{name}", project)
    end
    config_path = "#{project}/config.xml"
    File.write(config_path, File.read(config_path).sub('android-versionCode="1"', "android-versionCode=\"#{index + 1}\""))
    version = variant == 'release' ? release_version : current_version_number
    dependency = variant == 'release' ? "cordova-plugin-purchases@#{release_version}" : archive
    Dir.chdir(project) do
      sh('npm', 'install', dependency, '--save-exact', '--package-lock-only', '--no-audit', '--no-fund')
      sh('npm', 'ci', '--no-audit', '--no-fund')
      sh('npm', 'run', 'build')
    end
    commands = [
      ['npx', 'cordova', 'platform', 'add', "#{platform}@#{platform == 'ios' ? '8.0.0' : '14.0.1'}", '--nosave'],
      ['npx', 'cordova', 'plugin', 'add', "cordova-plugin-purchases@#{version}", '--searchpath', 'node_modules', '--nosave'],
      ['npx', 'cordova', 'plugin', 'add', "#{root}/e2e-tests/cordova-plugin-launch-args", '--nosave']
    ]
    commands.each_with_index do |args, command_index|
      sdk_update_test_build(args, "#{dir}/plugin-#{command_index}.log", api_key, directory: project)
    end
    metadata = sdk_update_test_dependency(project, platform, variant, version, root, archive)
    File.write("#{project}/www/build-config.js", "window.sdkUpdateConfig = #{JSON.generate(apiKey: api_key, sdkVersion: "#{version} #{metadata[:source]}")};\n")
    File.write("#{dir}/version.txt", metadata[:version])
    File.write("#{dir}/source.txt", metadata[:source])
    File.write("#{dir}/resolved-sdk.json", JSON.pretty_generate(metadata))
    FileUtils.cp("#{project}/package-lock.json", "#{dir}/package-lock.json")
    sdk_update_test_build(['npx', 'cordova', 'prepare', platform], "#{dir}/prepare.log", api_key, directory: project)
    sdk_update_test_copied_sources(project, platform, metadata)
    if platform == 'ios'
      native = "#{project}/platforms/ios"
      sdk_update_test_build(['bundle', 'exec', 'pod', 'install', '--repo-update'], "#{dir}/pods.log", api_key, directory: native)
      lock = File.read("#{native}/Podfile.lock")
      UI.user_error!('iOS resolved an unexpected hybrid-common version') unless
        lock.match?(/^  - PurchasesHybridCommon \(#{Regexp.escape(metadata[:hybrid_common])}\):/)
      FileUtils.cp("#{native}/Podfile.lock", "#{dir}/Podfile.lock")
      args = ['xcodebuild', '-workspace', "#{native}/App.xcworkspace", '-scheme', 'App',
        '-configuration', 'Debug', '-sdk', 'iphonesimulator', '-destination', 'generic/platform=iOS Simulator',
        '-derivedDataPath', "#{dir}/derived_data", 'ARCHS=arm64', 'IPHONEOS_DEPLOYMENT_TARGET=16.0', 'CODE_SIGNING_ALLOWED=NO']
      sdk_update_test_build(args, "#{dir}/build.log", api_key)
      FileUtils.cp_r("#{dir}/derived_data/Build/Products/Debug-iphonesimulator/SDKUpdateTester.app", "#{dir}/SDKUpdateTester.app")
    else
      native = "#{project}/platforms/android"
      FileUtils.cp("#{template}/verify-dependencies.gradle", "#{native}/app/build-extras.gradle")
      build_config = { android: { debug: { keystore: signing, storePassword: 'android', alias: 'androiddebugkey', password: 'android', keystoreType: 'jks' } } }
      File.write("#{project}/build.json", JSON.generate(build_config))
      sdk_update_test_build(['npx', 'cordova', 'build', 'android', '--debug', '--buildConfig=build.json'], "#{dir}/build.log", api_key, directory: project)
      sdk_update_test_build(['./gradlew', ':app:verifySdkUpdateDependencies'], "#{dir}/dependencies.log", api_key, directory: native)
      FileUtils.cp("#{native}/app/build/outputs/apk/debug/app-debug.apk", "#{dir}/SDKUpdateTester.apk")
    end
    UI.success("Built #{platform} #{variant}: #{version} #{metadata[:source]} (hybrid-common #{metadata[:hybrid_common]})")
  end
end

desc "Run a Cordova SDK update Maestro test case"
lane :run_sdk_update_test do |options|
  platform = sdk_update_test_platform(options)
  test_case = options[:test_case]
  UI.user_error!('test_case must be anonymous_user or logged_in_user') unless %w[anonymous_user logged_in_user].include?(test_case)
  apps = sdk_update_test_apps_dir(platform, options)
  flows = "#{get_root_folder}/e2e-tests/maestro/sdk_update_tests/#{test_case}"
  steps = %w[release local].each_with_index.map do |variant, index|
    dir = "#{apps}/#{variant}"
    UI.user_error!("#{dir}/version.txt not found. Build both apps first.") unless File.file?("#{dir}/version.txt")
    {
      app_path: "#{dir}/SDKUpdateTester.#{platform == 'ios' ? 'app' : 'apk'}",
      sdk_version: "#{File.read("#{dir}/version.txt").strip} #{File.read("#{dir}/source.txt").strip}",
      flow: "#{flows}/#{index.zero? ? 'before' : 'after'}_update.yaml"
    }
  end
  run_sdk_update_maestro_test(
    platform: platform, app_id: 'com.revenuecat.SDKUpdateTester', steps: steps,
    output_dir: "#{get_root_folder}/fastlane/test_output/sdk_update_tests/#{platform}/#{test_case}",
    max_attempts: Integer(options.fetch(:max_attempts, 3))
  )
end

def sdk_update_test_platform(options)
  platform = options[:platform].to_s
  UI.user_error!('platform must be ios or android') unless %w[ios android].include?(platform)
  platform
end

def sdk_update_test_apps_dir(platform, options)
  base = "#{get_root_folder}/build/sdk_update_tests"
  output = File.expand_path(options[:apps_dir] || options[:output_dir] || platform, base)
  UI.user_error!("SDK update app outputs must be inside #{base}") unless output.start_with?("#{base}/")
  output
end

def sdk_update_test_dependency(project, platform, variant, expected_version, root, archive)
  sdk = File.realpath("#{project}/node_modules/cordova-plugin-purchases")
  manifest = JSON.parse(File.read("#{sdk}/package.json"))
  lock = JSON.parse(File.read("#{project}/package-lock.json")).fetch('packages').fetch('node_modules/cordova-plugin-purchases')
  UI.user_error!('Installed SDK version differs from the selected version') unless manifest['version'] == expected_version
  if variant == 'release'
    registry = 'https://registry.npmjs.org/cordova-plugin-purchases/-/'
    UI.user_error!('Released app must resolve the published npm artifact') unless
      !lock['link'] && lock['version'] == expected_version && lock['resolved']&.start_with?(registry) && lock['integrity']
  else
    resolved = lock['resolved'].to_s.delete_prefix('file:')
    UI.user_error!('Local app must resolve the packed SDK checkout') unless
      !lock['link'] && File.expand_path(resolved, project) == archive && lock['integrity']
    %w[www/plugin.js src/android/PurchasesPlugin.java src/ios/PurchasesPlugin.swift plugin.xml].each do |name|
      UI.user_error!("Local package differs from the checkout: #{name}") unless
        Digest::SHA256.file("#{sdk}/#{name}").hexdigest == Digest::SHA256.file("#{root}/#{name}").hexdigest
    end
  end
  swift = File.read("#{sdk}/src/ios/PurchasesPlugin.swift")
  java = File.read("#{sdk}/src/android/PurchasesPlugin.java")
  UI.user_error!('Native Cordova wrapper versions differ from the selected SDK') unless
    swift.include?("return \"#{expected_version}\"") && java.include?("PLUGIN_VERSION = \"#{expected_version}\"")
  xml = File.read("#{sdk}/plugin.xml")
  phc = if platform == 'ios'
    xml.match(/name="PurchasesHybridCommon" spec="([^"]+)"/)[1]
  else
    xml.match(/com.revenuecat.purchases:purchases-hybrid-common:([^'"<]+)/)[1]
  end
  {
    version: expected_version, source: variant == 'release' ? 'Registry' : 'Local', path: sdk,
    hybrid_common: phc, registry_url: lock['resolved'], registry_integrity: lock['integrity'],
    javascript_sha256: Digest::SHA256.file("#{sdk}/www/plugin.js").hexdigest,
    swift_sha256: Digest::SHA256.hexdigest(swift), java_sha256: Digest::SHA256.hexdigest(java)
  }
end

def sdk_update_test_copied_sources(project, platform, metadata)
  native = "#{project}/platforms/#{platform}"
  source = platform == 'ios' ? 'PurchasesPlugin.swift' : 'PurchasesPlugin.java'
  compiled = Dir.glob("#{native}/**/#{source}")
  expected = metadata.fetch(platform == 'ios' ? :swift_sha256 : :java_sha256)
  UI.user_error!('App is not compiling the selected Cordova SDK sources') unless
    compiled.length == 1 && Digest::SHA256.file(compiled.first).hexdigest == expected
  scripts = Dir.glob("#{native}/**/www/plugins/cordova-plugin-purchases/www/plugin.js")
  javascript = File.read("#{metadata[:path]}/www/plugin.js")
  module_source = "cordova.define(\"cordova-plugin-purchases.plugin\", function(require, exports, module) {\n#{javascript}\n});\n"
  UI.user_error!('App is not loading the selected Cordova SDK JavaScript') unless
    scripts.length == 1 && File.read(scripts.first) == module_source
end

def sdk_update_test_build(args, log, api_key, directory: get_root_folder)
  require 'open3'
  status = nil
  File.open(log, 'w') do |file|
    Open3.popen2e({ 'BUNDLE_GEMFILE' => "#{get_root_folder}/Gemfile" }, *args, chdir: directory) do |input, output, process|
      input.close
      IO.copy_stream(output, file)
      status = process.value
    end
  end
  return if status.success?
  UI.error(File.readlines(log).last(150).join.gsub(api_key, '[redacted]'))
  UI.user_error!("SDK update app build failed; see #{log}")
end

desc "Generate docs"
lane :generate_docs do
  version_number = current_version_number
  docs_repo_base_url = "git@github.com:RevenueCat/"
  docs_repo_name = "cordova-plugin-purchases-docs"
  docs_repo_url = File.join(docs_repo_base_url, docs_repo_name)

  Dir.mktmpdir do |docs_generation_folder|
    # Must be run from the root dir
    Dir.chdir("..") do
      sh(
        "npx",
        "typedoc",
        "--out",
        docs_generation_folder
      )

      docs_index_path = File.join(Dir.pwd, "scripts/docs/index.html")

      # clone docs repo
      Dir.mktmpdir do |docs_repo_clone_dir|
        Dir.chdir(docs_repo_clone_dir) do
          sh("git", "clone", docs_repo_url)
          Dir.chdir(docs_repo_name) do
            # copy docs generated in the previous step into the docs folder and push the changes
            docs_destination_folder = "docs/#{version_number}"
            index_destination_path = "docs/index.html"
            FileUtils.cp_r docs_generation_folder, docs_destination_folder
            FileUtils.cp docs_index_path, index_destination_path

            # using sh instead of fastlane commands because fastlane would run from the repo root
            sh("git", "add", docs_destination_folder)
            sh("git", "add", index_destination_path)
            sh("git", "commit", "-m", "Update documentation for #{version_number}")
            sh("git", "push")
          end
        end
      end
    end
  end
end

###############################################################################
# Helper functions 🤜🤛                                                      #
###############################################################################

def get_phc_version
  file_contents = File.read('../plugin.xml')
  # This will parse the PHC version for iOS and android from within the plugin.xml file
  # iOS appears in the form: <pod name="PurchasesHybridCommon" spec="4.2.0"/>
  ios_phc_version = file_contents.split("<pod name=\"PurchasesHybridCommon\" spec=")[1].split('"')[1]
  # Android appears in the form: <framework src="com.revenuecat.purchases:purchases-hybrid-common:4.2.0" />
  android_phc_version = file_contents.split("<framework src=\"com.revenuecat.purchases:purchases-hybrid-common:")[1].split('"')[0]

  UI.error("PHC version does not match between iOS and android in plugin.xml. Please check those values") if ios_phc_version != android_phc_version

  ios_phc_version
end

def get_root_folder
  return File.expand_path('../../', __FILE__)
end

def current_version_number
  File.read("../.version").to_s.strip
end

def check_no_git_tag_exists(version_number)
  if git_tag_exists(tag: version_number, remote: true, remote_name: 'origin')
    raise "git tag with version #{version_number} already exists!"
  end
end
